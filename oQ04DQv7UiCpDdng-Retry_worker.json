{
  "name": "Retry worker",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const attempt = ($json.attempt || 0) + 1;\n\n// backoff_seconds kommt jetzt direkt aus $json\nconst delays = $json.backoff_seconds;  \n\n// falls es ein String wäre → absichern\nconst arr = Array.isArray(delays) ? delays : String(delays).split(',').map(x => Number(x.trim()));\n\nconst retry_in_s = arr[Math.min(attempt-1, arr.length-1)];\nconst next_retry_at = new Date(Date.now() + retry_in_s*1000).toISOString();\n\nreturn {\n  json: {\n    ...$json,\n    attempt,\n    retry_in_s,\n    next_retry_at,\n    status: attempt >= $json.max_attempts ? 'give_up' : 'open'\n  }\n};\n"
      },
