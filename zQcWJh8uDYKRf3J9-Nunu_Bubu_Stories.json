        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"prompt\": {{ JSON.stringify([\n    $node[\"AI Agent: Generate Video Concept1\"].json.output.story,\n    'LOOK: ' + $node[\"AI Agent: Generate Video Concept1\"].json.output.visual_direction.look,\n    'LIGHTING: ' + $node[\"AI Agent: Generate Video Concept1\"].json.output.visual_direction.lighting,\n    'CAMERA: ' + $node[\"AI Agent: Generate Video Concept1\"].json.output.visual_direction.camera,\n    'MATERIALS: ' + $node[\"AI Agent: Generate Video Concept1\"].json.output.visual_direction.materials,\n    'ENVIRONMENT: ' + $node[\"AI Agent: Generate Video Concept1\"].json.output.visual_direction.environment,\n    'ANIMATION CUES: ' + (($node[\"AI Agent: Generate Video Concept1\"].json.output.animation_cues || []).join(', '))\n  ].filter(Boolean).join('\\n')) }},\n  \"imageUrls\": [\n    \"https://drive.google.com/uc?export=download&id=1ipklMOzg6TZEVLlPSDVvH6Yc_B2metcX\"\n  ],\n  \"model\": \"veo3_fast\",\n  \"aspectRatio\": \"9:16\",\n  \"enableFallback\": false\n}\n",
        "options": {
          "batching": {
